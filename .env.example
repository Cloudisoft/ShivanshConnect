# ShivanshConnect - environment variables (full target surface, master spec section 96)
# Copy to .env (root) and/or apps/backend/.env, apps/frontend/.env, apps/worker/.env as needed.
# Never commit a real .env file. Only placeholders belong here.

# ---------------------------------------------------------------------------
# Core / shared
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase (Phase 1 - required)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Direct Postgres connection string, e.g. for scripts/migrations run outside the Supabase CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Frontend (Vite requires the VITE_ prefix to expose a var to browser code).
# Only ever put the URL and the ANON key in frontend env - never the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Redis / job queue (not used - every background loop in this build (lead import, knowledge-
# document processing, voice cloning, the Phase 7 campaign dispatcher, Phase 12 analytics
# aggregator, Phase 13 SMS/email dispatchers, Phase 15 call reconciliation job) runs via
# setImmediate/setInterval on the backend process itself, deliberately structured so each one's
# "run one unit of work" function is a drop-in for a real BullMQ job processor later - see each
# module's own header comment, e.g. apps/backend/src/services/campaignDispatcher.ts. This is
# EXPLICITLY DEFERRED BY DESIGN past this 15-phase build, not an oversight - see README's
# "Explicitly NOT built yet" list under Phase 15 for the real migration path.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# In-process scheduler tuning (all optional - every one has a working default; see the module
# named for exactly how it's used). Never required for local dev or a first deployment.
# ---------------------------------------------------------------------------
# Phase 7 campaign dispatcher: how often (ms) a tick runs, and the hardcoded worker-pool capacity
# ceiling `effectiveConcurrency()` enforces alongside each campaign's own concurrency_limit and the
# org's dialing_settings.max_concurrency.
CAMPAIGN_DISPATCH_INTERVAL_MS=3000
WORKER_POOL_CAPACITY=50
# Phase 12 analytics rollup aggregator tick interval (ms).
ANALYTICS_AGGREGATION_INTERVAL_MS=300000
# Phase 13 SMS/email campaign dispatcher tick intervals (ms).
SMS_DISPATCH_INTERVAL_MS=5000
EMAIL_DISPATCH_INTERVAL_MS=5000
# Phase 15 call-state reconciliation job (services/callReconciliation.ts): tick interval and how
# long a call may sit in a non-terminal status before it's considered "stuck" and probed against
# the real orchestration provider's getCall().
CALL_RECONCILIATION_INTERVAL_MS=300000
CALL_RECONCILIATION_STUCK_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Telephony number providers (Phase 5 - DIDs/phone numbers). Platform-level default; each org can
# also/instead store its own Twilio Account SID + Auth Token / Telnyx API key under Settings >
# Phone Providers (AES-256-GCM encrypted via CREDENTIAL_ENCRYPTION_KEY above - same helper Phase
# 4's voice providers use). BYON ("Bring Your Own Number") needs none of these - it is a manual
# declaration flow, not a third-party API (see apps/backend/src/lib/telephony/byon.ts).
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=

# ---------------------------------------------------------------------------
# Call orchestration (Phase 6 - two engines: Vapi (managed) and pipecat (self-hosted, a separate
# process - see apps/pipecat-service/README.md). VAPI_API_KEY is a platform-level default; each org
# can also/instead store its own key under Settings > Integrations (same CREDENTIAL_ENCRYPTION_KEY
# encrypts it). VAPI_WEBHOOK_SECRET is optional - when set, it's checked against the x-vapi-secret
# header Vapi's server-url config can be told to send; when unset the receiver still works (it
# relies on idempotency + payload-resolved org ownership either way, see routes/webhooks.ts).
# PIPECAT_SERVICE_URL/PIPECAT_SERVICE_TOKEN point the Node backend at the separately-deployed
# pipecat-service. DEEPGRAM_API_KEY is pipecat-service's own STT provider key (set on ITS
# deployment, apps/pipecat-service/.env - not read by the Node backend at all).
# ---------------------------------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
PIPECAT_SERVICE_URL=
PIPECAT_SERVICE_TOKEN=
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# AI / voice model providers. OPENAI_API_KEY is used starting Phase 3 (knowledge-base document
# embedding, knowledge search, agent preview). ELEVENLABS_API_KEY/CARTESIA_API_KEY are used
# starting Phase 4 (voices - platform-level default; each org can instead/also store its own key
# under Voice Providers, see CREDENTIAL_ENCRYPTION_KEY below). Not required for Phase 1-3.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional per-feature model overrides (all default to a real, working OpenAI model - only set
# these to point a specific feature at a different model). CALL_SUMMARY_MODEL is Phase 9's
# generateCallSummary.ts; CALL_EVALUATION_MODEL is Phase 11's evaluateCall.ts; AGENT_IMPROVEMENT_
# MODEL is Phase 11's aggregateAgentImprovements.ts recurring-issue mining.
CALL_SUMMARY_MODEL=
CALL_EVALUATION_MODEL=
AGENT_IMPROVEMENT_MODEL=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Phase 4 - the two self-hosted, GPU-only open-source voice models (OmniVoice/k2-fsa, VoxCPM/
# OpenBMB). Neither runs in this codebase - each is an HTTP client against a serverless GPU
# endpoint YOU deploy and point these at (see apps/backend/src/lib/voice/omnivoice.ts and
# voxcpm.ts for exact deployment steps: a Replicate custom model deployment for OmniVoice, VoxCPM's
# own official vLLM-Omni OpenAI-compatible server for VoxCPM). Without these set (per org, under
# Voice Providers, or here as a platform-level default), every OmniVoice/VoxCPM call fails with an
# honest "not configured" error - never fabricated audio. Not required for Phase 1-3.
OMNIVOICE_ENDPOINT_URL=
OMNIVOICE_API_KEY=
VOXCPM_ENDPOINT_URL=
VOXCPM_API_KEY=

# Phase 4 - required to store/read any voice_provider_credentials row (ElevenLabs/Cartesia API
# keys, OmniVoice/VoxCPM endpoint+key) - AES-256-GCM key, 64 hex chars or base64 decoding to 32
# bytes. Generate one with `openssl rand -hex 32`. This is also the pattern Phase 5 (Twilio/
# Telnyx), Phase 6 (Vapi) and Phase 13 (SMTP) are expected to reuse for their own credentials.
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Object storage. Phase 4 adds the first real (if minimal) implementation - generated voice-preview
# audio and voice-cloning reference samples are written to local disk under STORAGE_LOCAL_DIR
# (apps/backend/src/lib/storage/localDisk.ts) and served back by an unauthenticated, unguessable-
# key route - this is NOT production object storage (no replication, doesn't survive a redeploy to
# a new container). Real S3-compatible storage (master spec section 22) is still deferred; when it
# lands it is expected to read STORAGE_PROVIDER/STORAGE_BUCKET/etc. below and swap the default
# StorageAdapter without touching any call site.
# ---------------------------------------------------------------------------
STORAGE_LOCAL_DIR=./apps/backend/.data/voice-storage
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# ---------------------------------------------------------------------------
# Email / SMTP (used starting Phase 13 - notifications). Not required for Phase 1;
# apps/backend/src/lib/email.ts logs invitations/resets to the console until then.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=ShivanshConnect

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Only needed if a component ever needs to mint its own tokens outside Supabase Auth
# (not used by Phase 1 - Supabase Auth issues and verifies all session JWTs today).
JWT_SECRET=
SESSION_SECRET=
