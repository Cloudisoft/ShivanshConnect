# apps/pipecat-service's own environment - a SEPARATE deployment from the
# Node backend (apps/backend/.env). Copy to .env for local runs, or set
# these as real environment variables / Railway service variables in
# production. See README.md.

PORT=8100
ENV=development

# Shared secret with the Node backend - set the SAME value here and as
# PIPECAT_SERVICE_TOKEN in apps/backend/.env. Verified both directions:
# Node sends it as a bearer token on every request to this service, and
# this service sends it back the same way when posting events to Node's
# POST /api/v1/webhooks/pipecat. Leave both unset for local/dev only.
PIPECAT_SERVICE_TOKEN=

# Where this service posts call lifecycle + transcript events, e.g.
# http://localhost:4000/api/v1/webhooks/pipecat in local dev.
NODE_BACKEND_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/pipecat

# The publicly reachable base URL for this service's OWN WebSocket
# media-stream endpoint - Twilio/Telnyx connect here once a call answers.
# In production this is this service's own public domain (wss://...); in
# local dev, tunnel it with ngrok/cloudflared, e.g. wss://abc123.ngrok.io.
PUBLIC_MEDIA_STREAM_URL=

# LLM - reuses Phase 3's provider choice (OpenAI). Required for any call.
OPENAI_API_KEY=

# STT - Deepgram, a first-class pipecat-ai real-time STT service.
# Required for any call.
DEEPGRAM_API_KEY=

# TTS - at least one of these is required for any call. ElevenLabs is
# preferred when both are set (see app/pipeline.py). Both are the same
# providers Phase 4's voice-provider catalog already supports, so an org
# can reuse the same account/key here.
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
