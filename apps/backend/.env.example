# apps/backend - Phase 1 required variables. See root .env.example for the full target surface.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Phase 3 - required for knowledge-base document processing, knowledge search and agent preview to
# actually run an LLM/embedding call. Without it, those features return an honest "not configured"
# response (never fabricated output) - see root .env.example's "AI / voice model providers" section.
OPENAI_API_KEY=

# Phase 4 - voices. See root .env.example for the full explanation of each of these (platform-level
# defaults; each org can also/instead store its own credentials under Settings > Voice Providers).
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
OMNIVOICE_ENDPOINT_URL=
OMNIVOICE_API_KEY=
VOXCPM_ENDPOINT_URL=
VOXCPM_API_KEY=
CREDENTIAL_ENCRYPTION_KEY=
STORAGE_LOCAL_DIR=./.data/voice-storage

# Phase 5 - DIDs/phone numbers. Platform-level default; each org can also/instead store its own
# Twilio Account SID + Auth Token / Telnyx API key under Settings > Phone Providers (same
# CREDENTIAL_ENCRYPTION_KEY above encrypts these too). BYON needs no credentials at all - see
# apps/backend/src/lib/telephony/byon.ts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=
