# apps/backend - Phase 1 required variables. See root .env.example for the full target surface.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Phase 3 - required for knowledge-base document processing, knowledge search and agent preview to
# actually run an LLM/embedding call. Without it, those features return an honest "not configured"
# response (never fabricated output) - see root .env.example's "AI / voice model providers" section.
OPENAI_API_KEY=
