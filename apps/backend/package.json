{
  "name": "@shivanshconnect/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ShivanshConnect API - Fastify + TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "vitest run --config vitest.loadtest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.3.0",
    "@shivanshconnect/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "@types/ws": "^8.18.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "libphonenumber-js": "^1.13.13",
    "mammoth": "^1.8.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
